# Copy this file to .streamlit/secrets.toml and fill in your own Alpaca API
# keys to enable true real-time (not delayed) US stock prices.
#
# 1. Sign up free at https://alpaca.markets (Paper/Basic account is enough,
#    no funding or brokerage account required).
# 2. Go to your dashboard -> "API Keys" -> generate a key pair.
# 3. Paste the values below. Never commit the real secrets.toml file.

[alpaca]
api_key_id = "YOUR_ALPACA_API_KEY_ID"
secret_key = "YOUR_ALPACA_SECRET_KEY"
